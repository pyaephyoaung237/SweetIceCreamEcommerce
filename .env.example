# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pedalworks

# Long random string used to sign login cookies (change it!)
# generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-32-chars-min

# Currency shown in the shop (USD, EUR, GBP, THB, INR ...)
NEXT_PUBLIC_CURRENCY=USD
